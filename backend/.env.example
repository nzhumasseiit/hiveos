ENV=development

# Set in production (required when ENV=production)
JWT_SECRET=change-me

# Comma-separated list of allowed origins, e.g.:
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-frontend.com
# If unset, defaults to ["*"] (no credentialed requests).
CORS_ORIGINS=

# InfluxDB (required for /api/data and /api/data/latest)
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=your-influx-token
INFLUX_ORG=your-org
INFLUX_BUCKET=beehive

# OpenAI (required for /api/chat)
OPENAI_API_KEY=

# SQLite location for hive registry
DB_PATH=./hiveos.db

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me