ENV=development

# Required in production. Generate strong random values before deployment.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXP_HOURS=24

# Comma-separated list of allowed origins, e.g.:
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-frontend.com
# If unset, defaults to ["*"] (no credentialed requests).
CORS_ORIGINS=

# InfluxDB. These defaults match docker-compose.yml for local demos.
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=dev-influx-token
INFLUX_ORG=hiveos
INFLUX_BUCKET=beehive
INGEST_API_KEY=replace-with-random-edge-device-key

# OpenAI (required for /api/chat)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# SQLite location for hive registry
DB_PATH=./hiveos.db

ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-demo-password

# Local Grafana demo defaults. Change before any shared deployment.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana
